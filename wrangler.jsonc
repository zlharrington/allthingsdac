{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "allthingsdac",
  "main": "./secure-entry-worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "CLIENT_ADMIN_USERNAME": "matt",
    "GITHUB_SITE_IMAGES_OWNER": "zlharrington",
    "GITHUB_SITE_IMAGES_REPO": "allthingsdac",
    "GITHUB_SITE_IMAGES_BRANCH": "main"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/admin/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "GALLERY_BUCKET",
      "bucket_name": "allthingsdac-gallery"
    }
  ],
  "ratelimits": [
    {
      "name": "ESTIMATE_RATE_LIMITER",
      "namespace_id": "71841231",
      "simple": {
        "limit": 4,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "71841232",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
